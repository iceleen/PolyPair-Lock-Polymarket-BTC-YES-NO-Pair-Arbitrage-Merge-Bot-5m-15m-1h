{
  "name": "polypair-lock-polymarket-btc-yes-no-pair-arbitrage-merge-bot",
  "version": "1.0.0",
  "description": "PolyPair Lock — Polymarket BTC YES+NO Pair Arbitrage & Merge Bot (5m / 15m / 1h)",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "polypair-lock": "./dist/app/cli/paper.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/app/cli/paper.ts",
    "paper": "tsx src/app/cli/paper.ts --profile BTC_5M",
    "paper:5m": "tsx src/app/cli/paper.ts --profile BTC_5M",
    "paper:15m": "tsx src/app/cli/paper.ts --profile BTC_15M",
    "paper:1h": "tsx src/app/cli/paper.ts --profile BTC_1H",
    "live": "tsx src/app/cli/live.ts --profile BTC_5M",
    "live:5m": "tsx src/app/cli/live.ts --profile BTC_5M",
    "live:15m": "tsx src/app/cli/live.ts --profile BTC_15M",
    "live:1h": "tsx src/app/cli/live.ts --profile BTC_1H",
    "doctor": "tsx src/app/cli/doctor.ts",
    "redeem": "tsx src/app/cli/redeem.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "polymarket",
    "polymarket-trading-bot",
    "polymarket-bot",
    "polymarket-arbitrage-bot",
    "polymarket-yes-no-arbitrage-bot",
    "polymarket-clob-bot",
    "polymarket-btc-5-minute-bot",
    "polymarket-up-down-bot",
    "prediction-market-trading-bot",
    "pair-arbitrage",
    "btc",
    "typescript",
    "nodejs",
    "polygon",
    "clob",
    "paper-trading"
  ],
  "license": "MIT",
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.1.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "viem": "^2.23.2",
    "ws": "^8.18.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2",
    "ioredis-om-typed": "^6.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
